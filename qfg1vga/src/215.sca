closeCombat::handleEvent:
  link.b	0x4
  ;Z ===== CHEAT: Ctrl+Shift + click during combat -> zero enemy HP (instant win) =====
  ;Z Combat is mouse-driven and keyboard events never reach this handler, but a
  ;Z mouse event carries the keyboard modifier state. So the combo we detect is a
  ;Z left-click made while BOTH Ctrl and Shift are held. We zero the enemy HP and
  ;Z fall through, so the click's normal attack resolves the kill. An ordinary
  ;Z click (or Ctrl-only, or Shift-only) still fights normally.
  ;Z (Right-click can't be used: the verb/icon system consumes it before combat.)
  pushi.b	0x1f		; (pEvent type?)
  push0
  lap.b	0x1
  send	0x4
  push
  ldi.b	0x1		; evMOUSEBUTTON (a mouse press)
  and
  bnt.b	@ccWinSkip
  pushi.b	0x3d		; (pEvent modifiers?)
  push0
  lap.b	0x1
  send	0x4
  push
  ldi.b	0x4		; kSciKeyModCtrl - require Ctrl held
  and
  bnt.b	@ccWinSkip
  pushi.b	0x3d		; (pEvent modifiers?)
  push0
  lap.b	0x1
  send	0x4
  push
  ldi.b	0x3		; kSciKeyModShift - require Shift held
  and
  bnt.b	@ccWinSkip
  lal.b	0x1		; local1 = combat manager (may be 0 before combat inits)
  bnt.b	@ccWinSkip
  pushi.w	0x27b		; ([local1] theFighter:) hp: 0
  push1
  push0
  pushi.w	0x283
  push0
  lal.b	0x1
  send	0x4
  send	0x6
  ldi.b	0x0
  sag.w	0x118		; gMonsterHealth (global280) = 0 -> on-screen bar
ccWinSkip:
  pushi.b	0x1f
  push0
  lap.b	0x1
  send	0x4
  push
  ldi.b	0x2
  eq?
  bnt.b	@code_542
  pushi.b	0x49
  push1
  push1
  lap.b	0x1
  send	0x6
  ldi.b	0x1
  ret

